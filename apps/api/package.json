{
  "name": "@sentinelle/api", "version": "0.2.0", "private": true, "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "concurrently -k 'tsc -p tsconfig.json --watch --preserveWatchOutput' 'node --watch --env-file-if-exists=../../.env dist/main.js'",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@sentinelle/contracts": "*", "@nestjs/common": "^11.1.9", "@nestjs/core": "^11.1.9",
    "@nestjs/platform-express": "^11.1.9", "@nestjs/swagger": "^11.2.1",
    "class-transformer": "^0.5.1", "class-validator": "^0.14.2", "helmet": "^8.1.0",
    "jose": "^6.1.0", "pg": "^8.16.3", "reflect-metadata": "^0.2.2", "rxjs": "^7.8.2"
  },
  "devDependencies": { "@types/express": "^5.0.3", "@types/pg": "^8.15.5" }
}
