# Local development only. Use separate provisioned credentials in production.
NODE_ENV=development
DEV_AUTH_ENABLED=true
API_HOST=127.0.0.1
API_PORT=4000
INTERNAL_API_URL=http://127.0.0.1:4000
POSTGRES_PASSWORD=sentinelle-owner-local-only
DATABASE_ADMIN_URL=postgresql://sentinelle_owner:sentinelle-owner-local-only@127.0.0.1:5432/sentinelle
DATABASE_URL=postgresql://sentinelle_app:sentinelle-local-only@127.0.0.1:5432/sentinelle
# Disable DEV_AUTH_ENABLED before configuring a real provider.
# OIDC_ISSUER=https://your-identity-provider.example
# OIDC_AUDIENCE=sentinelle-api
# OIDC_JWKS_URI=https://your-identity-provider.example/.well-known/jwks.json
# OIDC_CLIENT_ID=your-confidential-web-client
# OIDC_CLIENT_SECRET=your-provider-client-secret
# PUBLIC_WEB_URL=https://your-sentinelle-domain.example
# SESSION_SECRET=base64-encoded-32-byte-random-key
# OIDC_SCOPE=openid profile your-api-scope
# OIDC_RESOURCE=https://your-api-resource-identifier
# OIDC_AUTHORIZATION_AUDIENCE=provider-specific-api-audience-if-required
# Optional local storage: uncomment this block, start the storage Compose profile
# and run npm run storage:init. These credentials are LOCAL DEVELOPMENT ONLY.
# S3_BUCKET=sentinelle-files
# S3_REGION=us-east-1
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_FORCE_PATH_STYLE=true
# AWS_ACCESS_KEY_ID=sentinelle-local
# AWS_SECRET_ACCESS_KEY=sentinelle-minio-local-only
# MINIO_ROOT_USER=sentinelle-local
# MINIO_ROOT_PASSWORD=sentinelle-minio-local-only
