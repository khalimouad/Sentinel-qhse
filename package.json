{
  "name": "sentinelle",
  "version": "0.2.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=22.14" },
  "scripts": {
    "dev": "npm run build -w @sentinelle/contracts && npm run build -w @sentinelle/api && concurrently -k 'npm run dev -w @sentinelle/api' 'npm run dev -w @sentinelle/web'",
    "build": "npm run build -w @sentinelle/contracts && npm run build -w @sentinelle/api && npm run build -w @sentinelle/web",
    "typecheck": "npm run build -w @sentinelle/contracts && npm run typecheck --workspaces --if-present",
    "test": "node --test apps/api/test/config.test.mjs apps/api/test/documents.test.mjs apps/api/test/reports.test.mjs apps/api/test/attachments.test.mjs",
    "test:integration": "node --env-file-if-exists=.env --test apps/api/test/isolation.test.mjs apps/api/test/documents-isolation.test.mjs apps/api/test/reports-isolation.test.mjs apps/api/test/attachments-isolation.test.mjs apps/api/test/http.test.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.mjs",
    "storage:init":"node --env-file-if-exists=.env apps/api/scripts/storage-init.mjs",
    "test:storage":"node --env-file-if-exists=.env --test apps/api/test/storage-http.test.mjs"
  },
  "devDependencies": { "concurrently": "^9.2.1", "typescript": "^5.9.3", "@types/node": "^24.10.0" },
  "dependencies": { "pg": "^8.16.3" }
}
